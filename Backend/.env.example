PORT=5000
CLIENT_URL=http://localhost:5000

# Paste your Razorpay test/live credentials here. Never put the secret in app.js.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# Optional: protects station availability management endpoints.
ADMIN_KEY=replace_with_a_long_random_value
